# ==========================================
# SEGURIDAD INFORMÁTICA - PLATAFORMA DE VIDEO
# VARIABLES DE ENTORNO (PLANTILLA)
# ==========================================

# Puerto del Frontend
FRONTEND_PORT=3000

# API Backend (Node.js)
BACKEND_PORT=4000
NODE_ENV=development

# Clave Secreta para Tokens JWT (Cambiar por un string seguro y aleatorio)
JWT_SECRET=super_secret_jwt_key_seguridad_informatica_2026
JWT_EXPIRES_IN=24h

# Base de Datos (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=videoplatform
DB_USER=secuser
DB_PASSWORD=secpassword123

# Bucket Storage Self-Hosted (MinIO)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=miniopassword123
MINIO_BUCKET_NAME=videos

# Streaming UDP / WebRTC
STREAMING_PORT_HTTP=5000
STREAMING_UDP_MIN_PORT=50000
STREAMING_UDP_MAX_PORT=50100
STREAM_TICKET_SECRET=stream_ticket_secret_key_change_me

